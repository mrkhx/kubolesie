# PostgreSQL is the source of truth for player progress.
DATABASE_URL=postgresql://kubolesie:kubolesie@localhost:5432/kubolesie?schema=public

# Redis is used only for locks, rate limits and temporary cache.
REDIS_URL=redis://localhost:6379

PORT=3000
NODE_ENV=development

# VK Callback API. Leave empty for local mock adapter.
# Never commit real secrets. See docs/vk-callback-setup.md
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

# memory | prisma
# prisma is used automatically when DATABASE_URL is reachable.
GAME_STORE=prisma

# Dev-only JSON snapshot for the in-memory store (not for production).
MEMORY_STORE_PATH=./data/memory-store.json

# Enable mock VK event HTTP endpoints (auto-on when NODE_ENV !== production).
ENABLE_MOCK_API=true
