generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  WOOD
  STONE
  IRON_ORE
  FIBER
  HIDE
  HERBS
  COAL
  RAW_MEAT
  SHREW_FUR
  CHITIN_PLATE
  SHINY_STONE
  FOOD
  LOG
  PLANK
  STICK
  COBBLESTONE
  IRON_INGOT
  SEED
  WHEAT
  STRING
  REED
  CLAY
  RAW_FISH
  COOKED_FISH
  MIST_RESIN
  BOG_CORE
  SEAL_SHARD_6
  ROOT_FIBER
  ROOT_CORE
  SEAL_SHARD_5
  ROT_RESIN
  BLACKROOT_CORE
  SEAL_SHARD_4
  BLACK_REED
  MARSH_HEART
  SEAL_SHARD_3
  GEAR_SCRAP
  STATION_CORE
  SEAL_SHARD_2
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum EquipmentSlot {
  WEAPON
  HEAD
  CHEST
  HANDS
  LEGS
  FEET
  AMULET
  RING
}

enum QuestStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  COMPLETED
  CLAIMED
}

enum ItemHistoryType {
  CREATED
  LOOTED
  EQUIPPED
  SALVAGED
  SOLD
  DESTROYED
}

enum BattleEventType {
  HIT
  CRIT
  DODGE
  DEFEAT
}

enum CombatMode {
  PVE
  PVP
}

enum CombatResult {
  WIN
  LOSS
  DRAW
}

enum CurrencyCode {
  COINS
  PREMIUM
}

model Player {
  id               String   @id @default(cuid())
  vkUserId         String   @unique @map("vk_user_id")
  name             String
  level            Int      @default(1)
  xp               Int      @default(0)
  hp               Int      @default(100)
  maxHp            Int      @default(100) @map("max_hp")
  energy           Int      @default(20)
  maxEnergy        Int      @default(20) @map("max_energy")
  coins            Int      @default(0)
  premium          Int      @default(0)
  currentLocation  String   @default("forest_clearing") @map("current_location")
  currentState     String   @default("start") @map("current_state")
  lastEnergyAt     DateTime @default(now()) @map("last_energy_at")
  lastDailyReset   DateTime @default(now()) @map("last_daily_reset")
  lastActiveAt     DateTime @default(now()) @map("last_active_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  stats            PlayerStats?
  resources        PlayerResource[]
  inventory        InventoryItem[]
  equipment        PlayerEquipment[]
  flags            PlayerFlag[]
  npcRelations     NpcRelation[]
  quests           PlayerQuest[]
  processedEvents  ProcessedEvent[]
  rewardClaims     RewardClaim[]
  currencyTx       CurrencyTransaction[]
  itemHistory      ItemHistory[]
  combatMatches    CombatMatch[]
  discoveries      PlayerDiscovery[]
  statistics       PlayerStatistics?
  rating           PlayerRating?
  clanMembership   ClanMember?
  clanApplications ClanApplication[]
  clanInvitesSent  ClanInvite[]      @relation("ClanInviteFrom")
  clanInvites      ClanInvite[]      @relation("ClanInviteTo")
  entitlements     PlayerEntitlement[]
  cosmetics        PlayerCosmetic?
  achievements     PlayerAchievement[]
  bossStats        PlayerBossStat[]
  contributions    ClanContribution[]
  clansLed         Clan[]
  weeklyScores     PlayerWeeklyScore[]
  listingsSold     MarketListing[]       @relation("MarketListingSeller")
  listingsBought   MarketListing[]       @relation("MarketListingBuyer")
  marketSales      MarketTransaction[]   @relation("MarketTxSeller")
  marketPurchases  MarketTransaction[]   @relation("MarketTxBuyer")
  auctionBids      AuctionBid[]
  highBids         MarketListing[]       @relation("AuctionHighBidder")
  notices          PlayerNotice[]
  jobs             PlayerJob[]
  jobTasks         PlayerJobTask[]
  productionBuildings PlayerProductionBuilding[]
  productionEvents ProductionEvent[]

  @@index([createdAt])
  @@index([lastActiveAt])
  @@map("players")
}

model PlayerStats {
  playerId   String @id @map("player_id")
  attack     Int    @default(5)
  defense    Int    @default(0)
  speed      Int    @default(10)
  critChance Float  @default(5) @map("crit_chance")
  critDamage Float  @default(150) @map("crit_damage")
  dodge      Float  @default(3)
  accuracy   Float  @default(95)
  luck       Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

model PlayerResource {
  id        String       @id @default(cuid())
  playerId  String       @map("player_id")
  resource  ResourceType
  amount    Int          @default(0)
  updatedAt DateTime     @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, resource])
  @@map("player_resources")
}

model InventoryItem {
  id           String   @id @default(cuid())
  playerId     String   @map("player_id")
  templateId   String   @map("template_id")
  itemLevel    Int      @default(1) @map("item_level")
  rarity       Rarity   @default(COMMON)
  enhanceLevel Int      @default(0) @map("enhance_level")
  createdAt    DateTime @default(now()) @map("created_at")

  player    Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  equipped  PlayerEquipment[]
  history   ItemHistory[]

  @@index([playerId])
  @@map("inventory_items")
}

model PlayerEquipment {
  id       String        @id @default(cuid())
  playerId String        @map("player_id")
  slot     EquipmentSlot
  itemId   String        @map("item_id")

  player Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([playerId, slot])
  @@unique([itemId])
  @@map("player_equipment")
}

model PlayerFlag {
  id        String   @id @default(cuid())
  playerId  String   @map("player_id")
  flag      String
  value     String   @default("1")
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, flag])
  @@index([flag])
  @@map("player_flags")
}

model NpcRelation {
  id         String @id @default(cuid())
  playerId   String @map("player_id")
  npcId      String @map("npc_id")
  trust      Int    @default(0)
  reputation Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, npcId])
  @@map("npc_relations")
}

model QuestTemplate {
  id          String      @id
  title       String
  description String
  defaultStatus QuestStatus @default(LOCKED) @map("default_status")

  playerQuests PlayerQuest[]

  @@map("quest_templates")
}

model PlayerQuest {
  id        String      @id @default(cuid())
  playerId  String      @map("player_id")
  questId   String      @map("quest_id")
  status    QuestStatus @default(LOCKED)
  progress  Json        @default("{}")
  updatedAt DateTime    @updatedAt @map("updated_at")

  player   Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  template QuestTemplate @relation(fields: [questId], references: [id])

  @@unique([playerId, questId])
  @@map("player_quests")
}

model ProcessedEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique @map("event_id")
  playerId  String?  @map("player_id")
  command   String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([createdAt])
  @@map("processed_events")
}

model RewardClaim {
  id         String   @id @default(cuid())
  playerId   String   @map("player_id")
  rewardType String   @map("reward_type")
  rewardRef  String   @map("reward_ref")
  createdAt  DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, rewardType, rewardRef])
  @@map("reward_claims")
}

model CurrencyTransaction {
  id            String       @id @default(cuid())
  playerId      String       @map("player_id")
  currency      CurrencyCode
  amount        Int
  balanceBefore Int          @map("balance_before")
  balanceAfter  Int          @map("balance_after")
  reason        String
  referenceId   String?      @map("reference_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("currency_transactions")
}

model ItemHistory {
  id        String          @id @default(cuid())
  itemId    String          @map("item_id")
  playerId  String          @map("player_id")
  type      ItemHistoryType
  meta      Json?
  createdAt DateTime        @default(now()) @map("created_at")

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  player Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_history")
}

model CombatMatch {
  id                   String        @id @default(cuid())
  playerId             String        @map("player_id")
  mode                 CombatMode    @default(PVE)
  enemyId              String        @map("enemy_id")
  opponentPlayerId     String?       @map("opponent_player_id")
  seasonId             String        @default("season_0") @map("season_id")
  seed                 String
  balanceVersion       String        @map("balance_version")
  result               CombatResult?
  playerSnapshot       Json          @map("player_snapshot")
  enemySnapshot        Json          @map("enemy_snapshot")
  attackerRatingBefore Int?          @map("attacker_rating_before")
  attackerRatingAfter  Int?          @map("attacker_rating_after")
  defenderRatingBefore Int?          @map("defender_rating_before")
  defenderRatingAfter  Int?          @map("defender_rating_after")
  rewardTier           String?       @map("reward_tier")
  startedAt            DateTime      @default(now()) @map("started_at")
  finishedAt           DateTime?     @map("finished_at")

  player Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  events CombatEvent[]

  @@index([playerId, startedAt])
  @@index([mode, startedAt])
  @@index([playerId, mode, startedAt])
  @@index([opponentPlayerId, startedAt])
  @@map("combat_matches")
}

model CombatEvent {
  id      String          @id @default(cuid())
  matchId String          @map("match_id")
  turn    Int
  actor   String
  type    BattleEventType
  value   Int

  match CombatMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, turn])
  @@map("combat_events")
}

model PlayerDiscovery {
  id          String   @id @default(cuid())
  playerId    String   @map("player_id")
  discoveryId String   @map("discovery_id")
  title       String
  seen        Boolean  @default(true)
  defeated    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, discoveryId])
  @@map("player_discoveries")
}

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

model PlayerStatistics {
  playerId              String @id @map("player_id")
  pveWins               Int    @default(0) @map("pve_wins")
  pveLosses             Int    @default(0) @map("pve_losses")
  pvpWins               Int    @default(0) @map("pvp_wins")
  pvpLosses             Int    @default(0) @map("pvp_losses")
  bossWins              Int    @default(0) @map("boss_wins")
  bossLosses            Int    @default(0) @map("boss_losses")
  craftedItems          Int    @default(0) @map("crafted_items")
  resourcesGathered     Int    @default(0) @map("resources_gathered")
  itemsLooted           Int    @default(0) @map("items_looted")
  rareItemsFound        Int    @default(0) @map("rare_items_found")
  coinsEarned           Int    @default(0) @map("coins_earned")
  coinsSpent            Int    @default(0) @map("coins_spent")
  tradesCompleted       Int    @default(0) @map("trades_completed")
  questsCompleted       Int    @default(0) @map("quests_completed")
  dailyQuestsCompleted  Int    @default(0) @map("daily_quests_completed")
  daysCompleted         Int    @default(0) @map("days_completed")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_statistics")
}

model PlayerBossStat {
  id       String @id @default(cuid())
  playerId String @map("player_id")
  bossId   String @map("boss_id")
  wins     Int    @default(0)
  losses   Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, bossId])
  @@index([playerId])
  @@map("player_boss_stats")
}

model PlayerRating {
  playerId             String   @id @map("player_id")
  pvpRating            Int      @default(1000) @map("pvp_rating")
  lifetimeScore        Int      @default(0) @map("lifetime_score")
  weeklyScore          Int      @default(0) @map("weekly_score")
  weeklyPeriod         String   @default("") @map("weekly_period")
  seasonId             String   @default("season_0") @map("season_id")
  weeklyPvpOpponents   String   @default("") @map("weekly_pvp_opponents")
  updatedAt            DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([lifetimeScore(sort: Desc)])
  @@index([pvpRating(sort: Desc)])
  @@index([weeklyPeriod, weeklyScore(sort: Desc)])
  @@map("player_ratings")
}

model Season {
  id       String       @id
  name     String
  startsAt DateTime     @map("starts_at")
  endsAt   DateTime     @map("ends_at")
  status   SeasonStatus @default(UPCOMING)

  @@map("seasons")
}

model Clan {
  id             String    @id @default(cuid())
  name           String
  nameKey        String    @unique @map("name_key")
  tag            String
  tagKey         String    @unique @map("tag_key")
  description    String    @default("")
  leaderPlayerId String    @map("leader_player_id")
  level          Int       @default(1)
  xp             Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  disbandedAt    DateTime? @map("disbanded_at")

  leader        Player             @relation(fields: [leaderPlayerId], references: [id])
  members       ClanMember[]
  applications  ClanApplication[]
  invites       ClanInvite[]
  contributions ClanContribution[]
  tasks         ClanTaskProgress[]

  @@index([xp(sort: Desc)])
  @@index([disbandedAt])
  @@map("clans")
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String   @map("clan_id")
  playerId String   @unique @map("player_id")
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clanId])
  @@map("clan_members")
}

model ClanApplication {
  id        String            @id @default(cuid())
  clanId    String            @map("clan_id")
  playerId  String            @map("player_id")
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clanId, status])
  @@index([playerId, status])
  @@map("clan_applications")
}

model ClanInvite {
  id          String       @id @default(cuid())
  clanId      String       @map("clan_id")
  fromPlayerId String      @map("from_player_id")
  playerId    String       @map("player_id")
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime?    @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  clan Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  from Player @relation("ClanInviteFrom", fields: [fromPlayerId], references: [id], onDelete: Cascade)
  to   Player @relation("ClanInviteTo", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([clanId, status])
  @@map("clan_invites")
}

model ClanContribution {
  id        String @id @default(cuid())
  clanId    String @map("clan_id")
  playerId  String @map("player_id")
  periodKey String @map("period_key")
  score     Int    @default(0)

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clanId, playerId, periodKey])
  @@index([clanId, periodKey])
  @@index([periodKey])
  @@map("clan_contributions")
}

model ClanTaskProgress {
  id          String    @id @default(cuid())
  clanId      String    @map("clan_id")
  periodKey   String    @map("period_key")
  taskId      String    @map("task_id")
  progress    Int       @default(0)
  target      Int
  completedAt DateTime? @map("completed_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, periodKey, taskId])
  @@index([periodKey])
  @@index([completedAt])
  @@map("clan_task_progress")
}

model Product {
  id           String       @id
  type         String
  name         String
  description  String
  price        Int          @default(0)
  currency     CurrencyCode @default(PREMIUM)
  availability String       @default("CATALOG")
  seasonId     String?      @map("season_id")

  @@map("products")
}

model PlayerEntitlement {
  id                     String   @id @default(cuid())
  playerId               String   @map("player_id")
  productId              String   @map("product_id")
  grantedAt              DateTime @default(now()) @map("granted_at")
  source                 String
  externalTransactionId  String?  @map("external_transaction_id")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, productId])
  @@index([playerId])
  @@map("player_entitlements")
}

model PlayerCosmetic {
  playerId     String  @id @map("player_id")
  profileFrame String? @map("profile_frame")
  title        String?
  badge        String?
  campTheme    String? @map("camp_theme")
  chatBadge    String? @map("chat_badge")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_cosmetics")
}

model PlayerAchievement {
  id            String   @id @default(cuid())
  playerId      String   @map("player_id")
  achievementId String   @map("achievement_id")
  grantedAt     DateTime @default(now()) @map("granted_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, achievementId])
  @@map("player_achievements")
}

model PlayerWeeklyScore {
  id        String @id @default(cuid())
  playerId  String @map("player_id")
  periodKey String @map("period_key")
  score     Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, periodKey])
  @@index([periodKey, score(sort: Desc)])
  @@map("player_weekly_scores")
}

enum MarketListingType {
  FIXED_PRICE
  AUCTION
}

enum MarketListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum MarketAssetKind {
  RESOURCE
}

model MarketListing {
  id             String              @id @default(cuid())
  sellerPlayerId String              @map("seller_player_id")
  listingType    MarketListingType   @map("listing_type")
  assetKind      MarketAssetKind     @map("asset_kind")
  assetRef       String              @map("asset_ref")
  quantity       Int
  unitPrice      Int                 @map("unit_price")
  totalPrice     Int                 @map("total_price")
  status         MarketListingStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at")
  expiresAt      DateTime            @map("expires_at")
  buyerPlayerId  String?             @map("buyer_player_id")
  soldAt         DateTime?           @map("sold_at")
  cancelledAt    DateTime?           @map("cancelled_at")
  requestId      String?             @map("request_id")
  startingPrice  Int?                @map("starting_price")
  currentBid     Int?                @map("current_bid")
  currentBidderPlayerId String?      @map("current_bidder_player_id")
  buyoutPrice    Int?                @map("buyout_price")
  bidCount       Int                 @default(0) @map("bid_count")
  extensionCount Int                 @default(0) @map("extension_count")

  seller       Player              @relation("MarketListingSeller", fields: [sellerPlayerId], references: [id], onDelete: Cascade)
  buyer        Player?             @relation("MarketListingBuyer", fields: [buyerPlayerId], references: [id], onDelete: SetNull)
  highBidder   Player?             @relation("AuctionHighBidder", fields: [currentBidderPlayerId], references: [id], onDelete: SetNull)
  transactions MarketTransaction[]
  bids         AuctionBid[]

  @@index([status, assetRef, unitPrice])
  @@index([sellerPlayerId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([listingType, status, expiresAt])
  @@index([currentBidderPlayerId, status])
  @@map("market_listings")
}

model MarketTransaction {
  id             String          @id @default(cuid())
  listingId      String          @map("listing_id")
  sellerPlayerId String          @map("seller_player_id")
  buyerPlayerId  String          @map("buyer_player_id")
  assetKind      MarketAssetKind @map("asset_kind")
  assetRef       String          @map("asset_ref")
  quantity       Int
  grossPrice     Int             @map("gross_price")
  fee            Int
  sellerNet      Int             @map("seller_net")
  createdAt      DateTime        @default(now()) @map("created_at")
  requestId      String?         @map("request_id")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller  Player        @relation("MarketTxSeller", fields: [sellerPlayerId], references: [id], onDelete: Cascade)
  buyer   Player        @relation("MarketTxBuyer", fields: [buyerPlayerId], references: [id], onDelete: Cascade)

  @@unique([listingId])
  @@index([createdAt])
  @@index([sellerPlayerId, createdAt])
  @@index([buyerPlayerId, createdAt])
  @@map("market_transactions")
}

enum AuctionBidStatus {
  HOLD
  REFUNDED
  SETTLED
  SUPERSEDED
}

model AuctionBid {
  id             String           @id @default(cuid())
  listingId      String           @map("listing_id")
  bidderPlayerId String           @map("bidder_player_id")
  amount         Int
  status         AuctionBidStatus @default(HOLD)
  createdAt      DateTime         @default(now()) @map("created_at")
  requestId      String?          @map("request_id")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  Player        @relation(fields: [bidderPlayerId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([bidderPlayerId, createdAt])
  @@map("auction_bids")
}

model PlayerNotice {
  id        String    @id @default(cuid())
  playerId  String    @map("player_id")
  kind      String
  body      String
  listingId String?   @map("listing_id")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, readAt])
  @@index([playerId, createdAt])
  @@map("player_notices")
}

enum JobProfession {
  LOGGER
  MINER
  FARMER
  FISHER
  HUNTER
  CRAFTER
}

enum JobTaskStatus {
  ACCEPTED
  COMPLETED
}

model PlayerJob {
  playerId        String        @map("player_id")
  profession      JobProfession
  xp              Int           @default(0)
  level           Int           @default(1)
  completedCount  Int           @default(0) @map("completed_count")
  dailyCompleted  Int           @default(0) @map("daily_completed")
  dailyPeriod     String        @default("") @map("daily_period")
  lastCompletedAt DateTime?     @map("last_completed_at")
  coinsEarned     Int           @default(0) @map("coins_earned")

  player Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tasks  PlayerJobTask[]

  @@id([playerId, profession])
  @@index([profession, level])
  @@map("player_jobs")
}

model PlayerJobTask {
  id          String        @id @default(cuid())
  playerId    String        @map("player_id")
  profession  JobProfession
  templateId  String        @map("template_id")
  slot        Int
  periodKey   String        @map("period_key")
  target      Int
  progress    Int           @default(0)
  coins       Int
  jobXp       Int           @map("job_xp")
  playerXp    Int           @map("player_xp")
  status      JobTaskStatus @default(ACCEPTED)
  acceptedAt  DateTime      @default(now()) @map("accepted_at")
  completedAt DateTime?     @map("completed_at")
  requestId   String?       @map("request_id")

  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  job    PlayerJob @relation(fields: [playerId, profession], references: [playerId, profession], onDelete: Cascade)

  @@unique([playerId, profession, periodKey, templateId])
  @@index([playerId, profession, status])
  @@index([periodKey, profession])
  @@index([completedAt])
  @@map("player_job_tasks")
}

enum ProductionBuildingType {
  WHEAT_FARM
  SAWMILL
  QUARRY
  MINE
  FISHERY
  PEN
}

enum ProductionEventKind {
  TICK
  COLLECT
  BUILD
  UPGRADE
}

model PlayerProductionBuilding {
  playerId           String                 @map("player_id")
  buildingType       ProductionBuildingType @map("building_type")
  level              Int                    @default(1)
  storedPrimary      Int                    @default(0) @map("stored_primary")
  storedSecondary    Int                    @default(0) @map("stored_secondary")
  accPrimaryMilli    Int                    @default(0) @map("acc_primary_milli")
  accSecondaryMilli  Int                    @default(0) @map("acc_secondary_milli")
  lastCalculatedAt   DateTime               @map("last_calculated_at")
  builtAt            DateTime               @default(now()) @map("built_at")
  upgradedAt         DateTime?              @map("upgraded_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, buildingType])
  @@index([buildingType, level])
  @@map("player_production_buildings")
}

model ProductionEvent {
  id                String                 @id @default(cuid())
  playerId          String                 @map("player_id")
  buildingType      ProductionBuildingType @map("building_type")
  kind              ProductionEventKind
  primaryAmount     Int                    @default(0) @map("primary_amount")
  secondaryAmount   Int                    @default(0) @map("secondary_amount")
  coins             Int                    @default(0)
  resourceUnits     Int                    @default(0) @map("resource_units")
  createdAt         DateTime               @default(now()) @map("created_at")
  requestId         String?                @map("request_id")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([buildingType, createdAt])
  @@index([playerId, createdAt])
  @@map("production_events")
}

